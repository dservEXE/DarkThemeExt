{
  "manifest_version": 3,
  "name": "Night Sites · Тёмная тема",
  "version": "1.0.1",
  "description": "Независимая тёмная тема для сайтов: общий выключатель, исключения и настройка яркости.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Night Sites — тёмная тема",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/moon-16.png", "32": "icons/moon-32.png" }
  },
  "icons": {
    "16": "icons/moon-16.png", "32": "icons/moon-32.png",
    "48": "icons/moon-48.png", "128": "icons/moon-128.png"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_about_blank": true
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
